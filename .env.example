# Required. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
LAB_API_TOKEN=replace-with-a-long-random-secret
LAB_PORT=8300

# Conservative defaults for the 8 GB mini-PC.
LAB_DEFAULT_TIMEOUT_S=120
LAB_MAX_TIMEOUT_S=300
LAB_MAX_MEMORY_MB=2048
LAB_MAX_CONCURRENT_RUNS=1
LAB_MAX_CODE_BYTES=250000
LAB_MAX_ARTIFACT_BYTES=100000000
LAB_RUNNER_UID=10001
LAB_RUNNER_GID=10001
